# ═══════════ وفدة | WAFDA — متغيرات البيئة ═══════════
# للتطوير: انسخه إلى .env.local. للإنتاج: Vercel ← Settings ← Environment Variables.

# قاعدة البيانات (إلزامي في الإنتاج): محتوى ملف حساب خدمة Firebase كاملًا (JSON بسطر واحد) أو بترميز base64.
# ⚠ سرّي — لا يُرفع الملف ولا القيمة على GitHub أبدًا.
FIREBASE_SERVICE_ACCOUNT=

# بديل التطوير: محاكي Firestore (يضبطه npm run dev:local تلقائيًا)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# الوضع التجريبي:
#   true  = صندوق الرسائل التجريبي (/dev/inbox) وصفحة الدفع التجريبية (/dev/checkout) + تعبئة البيانات التجريبية مرة واحدة عند البناء
#   false = الإنتاج الحقيقي (تُعطَّل الصفحتان التجريبيتان)
DEMO_MODE=true

# سر توقيع إشعارات الدفع (HMAC-SHA256)، 16 حرفًا على الأقل:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# سر المهام المجدولة: Vercel Cron يرسل Authorization: Bearer CRON_SECRET إلى /api/cron
CRON_SECRET=

# ── الإنتاج (DEMO_MODE=false) ──
# حساب الأدمن: يُنشأ عند النشر ويصله رابط إنشاء كلمة المرور بالبريد
ADMIN_EMAIL=

# البريد الفعلي عبر SMTP. مع Gmail: smtp.gmail.com و465 وبريدك وكلمة مرور تطبيق (myaccount.google.com/apppasswords)
# ⚠ SMTP_PASS سرّي
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM="وفدة" <you@example.com>

# واتساب: غير مفعّل في الإنتاج حتى يُربط مزوّد (يختفي من الواجهات تلقائيًا)
# الدفع في الإنتاج: تحويل بنكي يؤكده الأدمن من /admin/payments حتى تُربط بوابة دفع

# رابط المنصة (اختياري): يُستنتج من VERCEL_PROJECT_PRODUCTION_URL على Vercel، أو http://localhost:3000 محليًا
# APP_URL=https://wafda.example.com

# متقدم: تعطيل عامل المهام داخل خادم Next (استخدم npm run worker بدلًا منه)
# DISABLE_WORKER=true
